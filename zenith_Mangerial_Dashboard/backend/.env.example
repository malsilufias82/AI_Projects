# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME="Zenith API"
APP_VERSION="1.0.0"
ENVIRONMENT=local
DEBUG=true

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# ─────────────────────────────────────────────
# Database (PostgreSQL + asyncpg)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/zenith
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGODB_URL=mongodb://mongo:mongo@mongodb:27017
MONGODB_DATABASE=zenith
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:8101","http://localhost:8100"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:8101

# ─────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─────────────────────────────────────────────
# Email (SMTP) — required for forgot-password, account setup, etc.
# ─────────────────────────────────────────────
# Set to true to actually send emails; false logs instead
EMAIL_ENABLED=false
# SMTP host — use smtp.sendgrid.net (SendGrid), smtp.gmail.com (Gmail), smtp.office365.com (Outlook)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
# For SendGrid: username must be literally "apikey", password is your API key
# For Gmail/Outlook: use your email and an app password
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=your-sendgrid-api-key-or-app-password
# Must match a verified sender identity in your SMTP provider
EMAIL_FROM=your-verified-email@example.com
EMAIL_FROM_NAME=Zenith

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | console
